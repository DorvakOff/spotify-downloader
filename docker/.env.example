# Copie ce fichier en .env puis adapte les valeurs : cp .env.example .env
# Toutes les variables sont optionnelles (des defauts senses s'appliquent).

# --- Transport / API ---
# Image Docker a utiliser. Par defaut l'image publiee sur ghcr.io par les
# GitHub Actions. Mets `spotify-downloader:latest` pour forcer un build local.
IMAGE=ghcr.io/dorvakoff/spotify-downloader:latest
# Port HTTP de l'API expose par le NAS (le client Windows s'y connecte).
API_PORT=8787
# Token Bearer fixe (optionnel). Laisse VIDE pour auto-generation au 1er boot
# (recommande) ; recupere-le ensuite avec :
#   docker compose exec downloader cat /state/api_token
API_TOKEN=

# --- Bibliotheque ---
# Dossier HOTE ou stocker la musique (pointe vers ton disque de donnees).
# Ex. /mnt/data/Musique. Defaut : ./musique a cote du compose.
MUSIC_DIR=./musique

# --- Planification ---
# Intervalle entre deux syncs : 6h, 90m, 3600 (secondes)...
SYNC_INTERVAL=10m
# Lancer un sync immediatement au demarrage du conteneur (oui/non).
SYNC_ON_START=oui

# --- Qualite audio (surcharge settings.ini) ---
SPOTDL_FORMAT=mp3
SPOTDL_BITRATE=320k
SPOTDL_PROVIDERS=soundcloud youtube-music bandcamp
SPOTDL_THREADS=8
# Normalisation loudness -14 LUFS (oui/non).
SPOTDL_NORMALISER=oui
